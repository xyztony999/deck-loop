# deck-loop 后端运行环境变量（v3.1：Node/NestJS + PostgreSQL；ADR-016 自 MongoDB 迁移）
# 复制为 server-node/.env（本地）或服务器 /www/wwwroot/deck-loop/.env（宝塔加载）
# 真实文件已 gitignore，切勿提交

# 服务端口（缺省 8080；宝塔部署 18080）
PORT=18080

# PostgreSQL（ADR-016；账号密码仅写在真实 env；密码建议 hex 免 URL 编码）
# 与 UniGate 共实例不同 database；建表走 node dist/scripts/init-schema.js（应用不自动建表）
DATABASE_URL=postgresql://deck_loop:<密码>@127.0.0.1:5432/deck_loop

# 会话令牌签名密钥（随机长串，如 openssl rand -hex 32）
AUTH_TOKEN_SECRET=<随机密钥>

# 导出文件下载签名密钥 / 素材 URL 签名密钥
EXPORT_SIGN_SECRET=<随机密钥>
ASSET_URL_SECRET=<随机密钥>

# ADR-018（web-mgmt-20261125）：AI 网关/渠道域整体退役——
# GATEWAY_CHANNELS / GLM_API_KEY / CONFIG_ENC_KEY 不再消费，旧 .env 残留可删。
# AI 产出唯一路径 = coding agent 经 deck-loop MCP 远程模式直写（个人 API token，
# 网站「设置 → API token」签发）；导出/预览渲染始终在 MCP 本地 headless 执行。

# agent 直写载荷红线（可选；缺省 2MB，NestJS body limit 配套）
# AGENT_CONTENT_MAX_MB=2
