# deck-loop 后端运行环境变量（v3：Node/NestJS + MongoDB）
# 复制为 server-node/.env（本地）或服务器 /opt/deck-loop/deck-loop.env（systemd/PM2 加载）
# 真实文件已 gitignore，切勿提交

# 服务端口（缺省 8080）
PORT=8080

# MongoDB（副本集需带 replicaSet 参数；账号密码仅写在真实 env 中）
MONGODB_URI=mongodb://deck:<密码>@127.0.0.1:27017/deck_loop?authSource=deck_loop&replicaSet=rs0

# 会话令牌签名密钥（随机长串，如 openssl rand -hex 32）
AUTH_TOKEN_SECRET=<随机密钥>

# 导出文件下载签名密钥 / 素材 URL 签名密钥
EXPORT_SIGN_SECRET=<随机密钥>
ASSET_URL_SECRET=<随机密钥>

# AI 渠道（未配置时回落内置 MOCK「内置模拟渠道」；OpenAI 兼容适配器）
# 字段契约（server-node/src/platform/gateway/gateway-config.ts）：channelCode/channelName/
#   priority/enabled/apiKey|apiKeyEnv/apiBaseUrl/models[{modelCode,modelName,capabilityTags,enabled}]
# 密钥推荐独立 env（apiKeyEnv），GATEWAY_CHANNELS 本体可入库房配置而不带密值
# GLM 模板（ capabilityTags 四项=大纲/整稿/整稿调整/定向调整，全部必需）：
# GATEWAY_CHANNELS=[{"channelCode":"GLM","channelName":"智谱 GLM","priority":10,"enabled":true,"apiKeyEnv":"GLM_API_KEY","apiBaseUrl":"https://open.bigmodel.cn/api/paas/v4","models":[{"modelCode":"glm-4.7","modelName":"GLM-4.7","capabilityTags":["OUTLINE","FULL_GENERATE","FULL_ADJUST","TARGETED_ADJUST"],"enabled":true}]}]
# GLM_API_KEY=<你的智谱 API Key>
