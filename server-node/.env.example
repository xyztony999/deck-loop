# deck-loop v3 后端 env（代码直读 process.env，不引 config 包；密钥仅 env、禁入库禁进 VO）
# 应用端口（默认 8080，与宝塔 Nginx 反代配置对齐）
PORT=8080
# 监听地址（生产反向代理部署收窄为 127.0.0.1；默认 0.0.0.0 本地开发）
# HOST=127.0.0.1
# MongoDB 连接串（默认本地 deck_loop 库；跨文档编排事务需 replica set）
MONGODB_URI=mongodb://127.0.0.1:27017/deck_loop
# 雪花 worker 位段（0-1023，多实例部署时区分实例；默认 1，单实例假设）
SNOWFLAKE_WORKER_ID=1

# ---- 对外签发 URL 的公共前缀（必配，否则签出 localhost 地址客户端不可达）----
# 素材限时 URL（GET /files/{userId}/{hash}.{ext}?expires&sign；网关需放行 /files/ 到本服务）
ASSET_URL_PUBLIC_BASE_URL=http://localhost:8080/files
# 导出下载 URL（GET {base}/deliver/export/download?exportId&token；指向网关 /api 前缀）
EXPORT_DOWNLOAD_BASE_URL=http://localhost:8080

# ---- AI 渠道（未配置时回落内置 MOCK「内置模拟渠道」；OpenAI 兼容适配器）----
# 完整字段契约与 GLM 模板见 deploy/deck-loop.env.example
# 渠道管理端（设置→模型渠道）保存的 apiKey 用本密钥 AES-256-GCM 加密落库：
# 64 位 hex / 24 位 base64（32 字节）/ 任意口令（sha256 派生）；生产必配且不可轮换丢失
# CONFIG_ENC_KEY=<32字节主密钥>

