{
  "name": "@deck-loop/core",
  "version": "3.1.0",
  "description": "deck-loop v3 backend — NestJS 10 + TypeORM 0.3 / PostgreSQL single service (ADR-006/008/016)",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --watchman=false",
    "init-schema": "tsx src/scripts/init-schema.ts",
    "migrate:mongo-to-pg": "tsx scripts/migrate-mongo-to-pg.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "eventemitter2": "^6.4.9",
    "multer": "2.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "mongodb": "^6.12.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
